<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Messaging.UI.ViewModels"
             x:Class="Messaging.UI.Views.MainChatView"
             x:DataType="vm:MainChatViewModel">

    <Grid ColumnDefinitions="300,*" Background="#181825">
        <!-- Sidebar -->
        <Border Grid.Column="0" BorderBrush="#313244" BorderThickness="0,0,1,0">
            <ContentControl Content="{Binding Sidebar}" />
        </Border>

        <!-- Chat Area -->
        <Border Grid.Column="1">
            <ContentControl Content="{Binding ChatArea}" />
        </Border>
    </Grid>

</UserControl>
