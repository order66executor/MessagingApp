<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Messaging.UI.ViewModels"
             x:Class="Messaging.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid Background="#0B0D17">
        
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="40"
                CornerRadius="24"
                Width="400">
            <!-- Glassmorphism Effect -->
            <Border.Background>
                <SolidColorBrush Color="#1E2030" Opacity="0.8" />
            </Border.Background>
            <Border.BoxShadow>
                <BoxShadows>0 10 40 0 #50000000</BoxShadows>
            </Border.BoxShadow>
            
            <StackPanel Spacing="20">
                <TextBlock Text="Welcome Back" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#FFFFFF" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,10"/>
                
                <TextBox PlaceholderText="Server IP" 
                         Text="{Binding IpAddress}" 
                         CornerRadius="12"
                         Background="#2A2D3E"
                         Foreground="#FFFFFF"
                         BorderThickness="0"
                         Padding="12"/>
                
                <TextBox PlaceholderText="Port" 
                         Text="{Binding Port}" 
                         CornerRadius="12"
                         Background="#2A2D3E"
                         Foreground="#FFFFFF"
                         BorderThickness="0"
                         Padding="12"/>
                
                <TextBox PlaceholderText="Username" 
                         Text="{Binding Username}" 
                         CornerRadius="12"
                         Background="#2A2D3E"
                         Foreground="#FFFFFF"
                         BorderThickness="0"
                         Padding="12"/>
                         
                <TextBox PlaceholderText="Password" 
                         Text="{Binding Password}" 
                         PasswordChar="•"
                         CornerRadius="12"
                         Background="#2A2D3E"
                         Foreground="#FFFFFF"
                         BorderThickness="0"
                         Padding="12"/>
                
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#f38ba8" 
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
                           TextWrapping="Wrap" />
                
                <Button Content="Connect" 
                        Command="{Binding ConnectCommand}" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        Background="#6610f2" 
                        Foreground="#FFFFFF" 
                        CornerRadius="12"
                        FontWeight="Bold"
                        Padding="16"
                        Margin="0,16,0,0">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#7b2cbf"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
