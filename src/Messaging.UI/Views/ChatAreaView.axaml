<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Messaging.UI.ViewModels"
             x:Class="Messaging.UI.Views.ChatAreaView"
             x:DataType="vm:ChatAreaViewModel"
             Background="#181825">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#1e1e2e" Padding="16" BorderBrush="#313244" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding PartnerUsername, TargetNullValue='No conversation selected'}" 
                           Foreground="#cdd6f4" 
                           FontWeight="Bold" 
                           FontSize="18" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Message List -->
        <ScrollViewer Grid.Row="1" Margin="16">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Simple message view for now -->
                        <Border Background="#313244" CornerRadius="12" Padding="12,8" Margin="0,4" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding}" Foreground="#cdd6f4" TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input Area -->
        <Border Grid.Row="2" Background="#1e1e2e" Padding="16" BorderBrush="#313244" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" 
                         PlaceholderText="Type a message..." 
                         Text="{Binding MessageInput}" 
                         CornerRadius="20"
                         Padding="16,8"
                         Margin="0,0,12,0"
                         Background="#181825"
                         BorderThickness="0">
                     <TextBox.KeyBindings>
                         <KeyBinding Gesture="Enter" Command="{Binding SendMessageCommand}" />
                     </TextBox.KeyBindings>
                </TextBox>
                
                <Button Grid.Column="1" 
                        Content="Send" 
                        Command="{Binding SendMessageCommand}"
                        Background="#89b4fa" 
                        Foreground="#11111b" 
                        CornerRadius="20"
                        Padding="24,8"/>
            </Grid>
        </Border>
        
        <!-- Empty State Overlay -->
        <Grid Grid.RowSpan="3" Background="#181825" IsVisible="{Binding PartnerUsername, Converter={x:Static ObjectConverters.IsNull}}">
            <TextBlock Text="Select a conversation to start chatting" 
                       Foreground="#7f849c" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       FontSize="16"/>
        </Grid>
    </Grid>

</UserControl>
