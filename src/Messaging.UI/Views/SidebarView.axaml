<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Messaging.UI.ViewModels"
             x:Class="Messaging.UI.Views.SidebarView"
             x:DataType="vm:SidebarViewModel"
             Background="#1e1e2e">

    <Grid RowDefinitions="Auto,*,Auto" Margin="8">
        
        <!-- Search / New Contact Header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Conversations" FontWeight="Bold" Foreground="#cdd6f4" FontSize="18"/>
        </StackPanel>

        <!-- Conversation List -->
        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding Conversations}"
                 SelectedItem="{Binding SelectedConversation}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="12" Margin="0,2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#89b4fa">
                                <TextBlock Text="{Binding [0]}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#11111b" FontWeight="Bold" FontSize="18"/>
                            </Border>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#cdd6f4" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Start New Chat Section -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
            <TextBox PlaceholderText="Enter exact username..." 
                     Text="{Binding NewContactUsername}" 
                     CornerRadius="6"/>
            <Button Content="Start Chat" 
                    Command="{Binding StartNewChatCommand}"
                    HorizontalAlignment="Stretch" 
                    HorizontalContentAlignment="Center"
                    Background="#313244"
                    Foreground="#cdd6f4"
                    CornerRadius="6"/>
        </StackPanel>
        
    </Grid>

</UserControl>
